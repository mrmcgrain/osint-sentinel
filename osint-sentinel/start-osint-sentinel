#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
export PATH="/data/data/com.termux/files/usr/bin:$PATH"
url=http://127.0.0.1:8765
ready() {
    [[ "$(curl --noproxy '*' -fsS --max-time 2 "$url/healthz" 2>/dev/null)" == 'osint-sentinel-ready-v1' ]]
}
fail() {
    printf '\n%s\n' "$1" >&2
    read -r -p 'Press Enter to close. ' _ || true
    exit 1
}
for tool in proot-distro curl flock termux-open-url; do
    command -v "$tool" >/dev/null || fail "Missing Termux command: $tool. See INSTALL-STARTUP.md."
done
if ready; then
    termux-open-url "$url/"
    exit 0
fi
mkdir -p "$HOME/.cache/osint-sentinel"
exec 9>"$HOME/.cache/osint-sentinel/start.lock"
if ! flock -n 9; then
    for ((i=0; i<60; i++)); do
        if ready; then termux-open-url "$url/"; exit 0; fi
        sleep 1
    done
    fail 'Sentinel is already starting or running but is not responding. Check its Termux session.'
fi
# Recheck after locking to handle simultaneous taps.
if ready; then termux-open-url "$url/"; exit 0; fi
printf 'Starting OSINT Sentinel in your existing Debian...\n'
proot-distro login debian -- bash -lc '
    test -f "$HOME/osint-sentinel/server.py" || {
        echo "Missing ~/osint-sentinel/server.py inside Debian. Install the application update first." >&2
        exit 1
    }
    exec python3 "$HOME/osint-sentinel/server.py"
' &
server_pid=$!
cleanup() {
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
for ((i=0; i<60; i++)); do
    if ! kill -0 "$server_pid" 2>/dev/null; then
        wait "$server_pid" || true
        fail 'Sentinel could not start. Read the error above; no Debian reinstall is needed.'
    fi
    if ready; then
        termux-open-url "$url/" || printf 'Open %s/ in Chrome.\n' "$url"
        printf 'Ready. Keep this Termux session running. Ctrl+C stops Sentinel.\n'
        wait "$server_pid" || fail 'Sentinel exited with an error. Read the output above.'
        exit 0
    fi
    sleep 1
done
fail 'Sentinel did not respond within 60 seconds. Check the output above and whether port 8765 is occupied.'
